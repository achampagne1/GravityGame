    "m_FunctionBody": "float r = max(1.0 - saturate(radial), 0.01);   \nfloat k = (lensRadius * lensRadius) / (r * r);   \nfloat fade = 1.0 - smoothstep(0.5, 1.0, r);       \nuv = p - (p - c) * k * fade;\nmask = saturate((r - holeRadius) / max(fwidth(r), 1e-4)); "
}

