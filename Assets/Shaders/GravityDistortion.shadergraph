{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "fc8db06660164061b322ada76e9337d6",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "gracityLens (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2509.000244140625,
            "y": -673.0001220703125,
            "width": 142.0,
            "height": 62.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a8ecea294d46421aaa8852a31f4bb706"
        },
        {
            "m_Id": "8746ae9301a94f6b8988f77f9508c00c"
        },
        {
            "m_Id": "33229e344a6e4c93aea2073a56ac6a16"
        },
        {
            "m_Id": "8a9a36d594554d21a3ec77dada8303e9"
        },
        {
            "m_Id": "98ea762a70214f839698aa622517f2b1"
        },
        {
            "m_Id": "286e940ab30042e8bf200cdcebb49e92"
        },
        {
            "m_Id": "1d70d5aa1e4d4d63a3de4385731e4d1f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "gracityLens",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float r = max(1.0 - saturate(radial), 0.01);        // 0 at hole center, 1 at sprite edge\nfloat k = (lensRadius * lensRadius) / (r * r);      // lens strength, falls off as 1/r²\nfloat fade = 1.0 - smoothstep(0.5, 1.0, r);         // 0 at sprite edge, so no seam\nuv = p - (p - c) * k * fade;\nmask = saturate((r - holeRadius) / max(holeRadius * 0.5, 1e-4));  // 0 inside the dark core"
}

